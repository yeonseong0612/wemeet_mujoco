<mujoco model="wemeet_scene">
    <!-- radian으로 통일: include된 ur10e.xml(angle=radian, joint range ±2π)이 전역에 적용되므로
         scene.xml의 euler 값도 radian으로 작성한다. (degree로 두면 포트/카메라가 radian으로 오해석됨) -->
    <compiler angle="radian"/>

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <include file="robots/ur10e/ur10e.xml"/>

    <asset>
        <!-- Port.obj is modelled in millimetres → scale to metres -->
        <mesh name="charge_port_mesh" file="Port.obj" scale="0.001 0.001 0.001"/>
    </asset>

    <visual>
        <headlight
            ambient="0.3 0.3 0.3"
            diffuse="0.6 0.6 0.6"
            specular="0.1 0.1 0.1"/>
    </visual>

    <worldbody>

        <light
            name="main_light"
            pos="0 0 3"
            dir="0 0 -1"
            directional="true"
            diffuse="0.8 0.8 0.8"
            ambient="0.2 0.2 0.2"/>

        <geom
            name="floor"
            type="plane"
            pos="0 0 0"
            size="5 5 0.1"
            rgba="0.5 0 0.8 1"/>

        <!-- Charging-port target (FoundationPose 6DoF estimation 대상) -->
        <!-- 로봇 앞(+Y) 0.8 m. 실제 소켓 결합면(2구멍 커넥터)은 mesh object +Z 쪽(Port.obj 실제 확인).
             quat=(0.7071,0.7071,0,0) = 90° about world X: 소켓면 object +Z -> world -Y(로봇쪽),
             AC 상단 object +Y -> world +Z(위) = 로봇이 정면에서 결합하는 장착 자세 -->
        <body name="charge_port_frame" pos="0 0.8 0.6" quat="0.70710678 0.70710678 0 0">


            <geom name="charge_port_visual"
                  type="mesh"
                  mesh="charge_port_mesh"
                  pos="0 0 0"
                  euler="0 0 0"
                  contype="0"
                  conaffinity="0"
                  rgba="0.2 0.2 0.2 1"/>

            <!-- [Col-2] 소켓 입구 테두리 collision — 8개 cylinder 기둥 고리(crown)로 근사.
                 입구평면(Port local X-Y, z=0)의 반지름 0.028m 원주에 45°씩 균등 배치.
                 중심 charge_port_center=(0,-0.02,0) → y=-0.02+0.028·sinθ, x=0.028·cosθ.
                 입구 안쪽 반지름 = 28-7 = 21mm, peg(ee_tip r=20mm)와 1mm 여유 → 정렬 통과/오정렬 접촉.
                 각 기둥 축은 삽입축(local Z)과 평행(euler 0 0 0, Z대칭이라 회전 불필요).
                 contype/conaffinity=2 → 로봇 링크(=1)·바닥과 무충돌, 충전건 tip과만 감지.
                 group=2 → 기본 렌더 숨김(디버그 시만 표시). rgba 반투명 파랑(디버깅용). -->
            <geom name="port_rim_0" type="cylinder" size="0.007 0.005" pos="0.028 -0.02 0"        euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>
            <geom name="port_rim_1" type="cylinder" size="0.007 0.005" pos="0.019799 -0.000201 0"  euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>
            <geom name="port_rim_2" type="cylinder" size="0.007 0.005" pos="0 0.008 0"             euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>
            <geom name="port_rim_3" type="cylinder" size="0.007 0.005" pos="-0.019799 -0.000201 0" euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>
            <geom name="port_rim_4" type="cylinder" size="0.007 0.005" pos="-0.028 -0.02 0"        euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>
            <geom name="port_rim_5" type="cylinder" size="0.007 0.005" pos="-0.019799 -0.039799 0" euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>
            <geom name="port_rim_6" type="cylinder" size="0.007 0.005" pos="0 -0.048 0"            euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>
            <geom name="port_rim_7" type="cylinder" size="0.007 0.005" pos="0.019799 -0.039799 0"  euler="0 0 0" contype="2" conaffinity="2" group="2" rgba="0 0.5 1 0.3"/>

            <!-- 소켓 입구(커넥터 돌출부 앞면) 중심. Port.obj 실측: 결합면 Z≈0 (mesh AABB Z [-0.115, +0.0087]).
                 alpha=0: 렌더 시 숨김(IK/타겟은 site pos 사용, 무관) -->
            <site name="charge_port_center"
                  pos="0 -0.02 0"
                  size="0.025"
                  rgba="0 1 0 0"/>
            <!-- 삽입축 기준점: 소켓 안쪽(-Z) 0.10 m. alpha=0: 렌더 시 숨김 -->
            <site name="charge_port_axis_site"
                  pos="0 -0.02 -0.10"
                  size="0.02"
                  rgba="1 0 0 0"/>
            <!-- 접근: 소켓 바깥(+Z) 0.15 m (로봇쪽). alpha=0: 렌더 시 숨김(IK/타겟은 site pos 사용, 무관) -->
            <site name="charge_port_approach"
                  pos="0 -0.02 0.15"
                  size="0.025"
                  rgba="1 0.6 0 0"/>
            <!-- 삽입: 소켓 안쪽(-Z) 0.02 m (착좌). alpha=0: 렌더 시 숨김 -->
            <site name="charge_port_insert"
                  pos="0 -0.02 -0.02"
                  size="0.02"
                  rgba="0 0 1 0"/>
        </body>

        <camera
            name="overview_camera"
            pos="2 -3 2"
            euler="1.0472 0 0.6109"
            fovy="45"/>  <!-- 60 0 35 deg ->

        <!-- Dedicated RGB-D camera facing the port head-on (FoundationPose 입력용) -->
        <camera
            name="cam_port"
            pos="0 -0.2 0.6"
            xyaxes="1 0 0  0 0 1"
            fovy="45"/>

        <!-- Stereo camera pair: baseline 0.12 m along world-X, parallel optical axes -->
        <camera
            name="stereo_left"
            pos="-0.06 -1.5 1.2"
            euler="0.8901 0 0"
            fovy="45"/>  <!-- 51 deg -->
        <camera
            name="stereo_right"
            pos="0.06 -1.5 1.2"
            euler="0.8901 0 0"
            fovy="45"/>  <!-- 51 deg -->
    </worldbody>
</mujoco>